# Zalo API credentials
# Get these from: https://developers.zalo.me/

# Your Zalo app's Access Token (from Zalo Developer Console)
ZALO_ACCESS_TOKEN=your_access_token_here

# Your girlfriend's Zalo User ID
# Run: node src/setup.js  to find her user ID after authorizing
RECIPIENT_USER_ID=her_zalo_user_id_here

# Optional: Customize the messages
LUNCH_MESSAGE=Em ơi, nhớ ăn cơm trưa và uống nước nha! 🍱💧 Anh nhắc em đó~ 💕
DINNER_MESSAGE=Em ơi, nhớ ăn tối và uống nước nha! 🍜💧 Anh thương em~ 💕
